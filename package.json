{
	"name": "companion-surface-logitech-mx-creative-console",
	"version": "1.0.1",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky && run build:artwork",
		"format": "prettier -w .",
		"package": "run build && companion-surface-build",
		"build": "rimraf dist && run build:artwork && run build:main && run build:manifest-usb-ids",
		"build:artwork": "node ./tools/build-artwork.mjs",
		"build:main": "tsc -p tsconfig.build.json",
		"build:manifest-usb-ids": "node ./tools/update-usb-ids.mjs",
		"dev": "run build:artwork && tsc -p tsconfig.build.json --watch",
		"preview:artwork": "node ./tools/preview-artwork.mjs",
		"lint:raw": "eslint",
		"lint": "run lint:raw ."
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-surface-logitech-mx-creative-console.git"
	},
	"engines": {
		"node": "^22.18",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-surface/base": "1.5.0-nightly-main-20261014-213444-0afe929",
		"@logitech-mx-creative-console/node": "0.3.0-nightly-main-20261016-192800-cae32d4"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.0",
		"@types/node": "^22.20.5",
		"@types/semver": "^7.8.0",
		"eslint": "^10.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.2"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.1"
}
